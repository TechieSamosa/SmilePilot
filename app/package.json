{
  "name": "smilepilot",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "description": "SmilePilot - offline-first AI dental clinic app (Android + iPhone), per-clinic builds",
  "scripts": {
    "dev": "vite --host",
    "dev:braceplace": "cross-env VITE_PRESET=abhidnya vite --host",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/make-icons.mjs --brand sowmya --android && node scripts/make-icons.mjs --brand abhidnya --ios",
    "build": "tsc --noEmit && vite build",
    "build:sowmya": "tsc --noEmit && cross-env VITE_PRESET=sowmya vite build",
    "build:braceplace": "tsc --noEmit && cross-env VITE_PRESET=abhidnya vite build",
    "preview": "vite preview --host",
    "android:apk": "npm run build:sowmya && npx cap sync android && node scripts/build-apk.mjs",
    "ios:sync": "npm run build:braceplace && npx cap sync ios"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/local-notifications": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@fontsource/dm-sans": "^5.3.0",
    "dexie": "4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "dicom-parser": "^1.8.21",
    "jspdf": "^4.0.0",
    "jspdf-autotable": "^5.0.0",
    "jszip": "^3.10.1",
    "onnxruntime-web": "1.30.0",
    "react": "19.1.10",
    "react-dom": "19.1.10"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "6.1.2",
    "cross-env": "^10.1.0",
    "sharp": "^0.35.5",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}